#!/usr/bin/env bash
# 강제 푸시(비-fast-forward)와 보호 브랜치 삭제를 막는다.
# 2026-09-18 에 모듈 브랜치를 push -f 로 덮어써 팀원 커밋 두 건이 사라진 뒤 도입.
# 설치: bash scripts/setup.sh  (또는 git config core.hooksPath .githooks)

set -u
ZERO=0000000000000000000000000000000000000000
PROTECTED="main capture guide score server model app poc/full"

is_protected() {
  for p in $PROTECTED; do [ "$1" = "$p" ] && return 0; done
  return 1
}

fail() {
  echo "" >&2
  echo "  ✗ 푸시를 막았습니다 — $1" >&2
  echo "" >&2
  echo "    브랜치: $2" >&2
  echo "" >&2
  shift 2
  for line in "$@"; do echo "    $line" >&2; done
  echo "" >&2
  echo "    규칙: docs/work-split-modules-v6.md §0-1" >&2
  echo "" >&2
  exit 1
}

while read -r local_ref local_sha remote_ref remote_sha; do
  branch="${remote_ref#refs/heads/}"

  # 1. 브랜치 삭제
  if [ "$local_sha" = "$ZERO" ]; then
    if is_protected "$branch"; then
      fail "보호 브랜치는 지울 수 없습니다" "$branch" \
        "정말 지워야 하면 GitHub 웹에서 하거나 팀에 먼저 알리세요."
    fi
    continue
  fi

  # 2. 새 브랜치는 통과
  [ "$remote_sha" = "$ZERO" ] && continue

  # 3. 원격 커밋이 내 커밋의 조상이 아니면 = 강제 푸시 (원격 이력을 버린다)
  if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
    lost=$(git rev-list --count "$local_sha..$remote_sha" 2>/dev/null || echo "?")
    who=$(git log -1 --format='%an' "$remote_sha" 2>/dev/null || echo "누군가")

    if is_protected "$branch"; then
      fail "보호 브랜치에 강제 푸시" "$branch" \
        "원격에만 있는 커밋 ${lost}개가 사라집니다 (마지막 작성자: ${who})." \
        "" \
        "  최신을 따라가려면:  git merge origin/${branch}" \
        "  모듈 브랜치는 덮어쓰지 않습니다. 원격 커밋을 살린 채 합칩니다."
    fi

    # 여기까지 왔으면 보호 브랜치가 아니다 = 임시 실험 브랜치(<모듈>-<무엇>)
    if [ "${FORCE_OK:-}" != "1" ]; then
      fail "강제 푸시 (임시 브랜치라도 확인이 필요합니다)" "$branch" \
        "원격에만 있는 커밋 ${lost}개가 사라집니다 (마지막 작성자: ${who})." \
        "" \
        "  내 임시 브랜치가 확실하면:  FORCE_OK=1 git push --force-with-lease" \
        "  아니면:                    git merge origin/${branch}"
    fi
    echo "  ! ${branch}: 강제 푸시를 FORCE_OK=1 로 허용합니다 (커밋 ${lost}개 사라짐)" >&2
  fi
done

exit 0
