# FROM node:22-alpine AS builder
FROM node:24 AS builder

WORKDIR /app

# 2026-10-14: 화면을 리액트로 갈아탔다 (client → client-react).
# 옛 화면은 `client/` 에 그대로 남아 있다 — 되돌리려면 아래 세 줄의 폴더 이름만 바꾸면 된다.
COPY ./client-react/package*.json ./
RUN npm ci

# 옛 화면이 받던 `rules/` · `poc/` · `eval/` 은 안 받는다.
# client-react 는 제 폴더 안의 `rules/` 를 읽고(src/core/score.ts 의 `../../rules/score.json`),
# 테스트가 없어 `eval/` 도 필요 없다 — 받을 것이 client-react 하나뿐이다
# 본 앱 core 와 저장소의 rules 를 **같은 상대 자리**에 둔다 (#454 D4) —
# client-react 는 vite alias(@core) 로 ../client/src/core 를 그대로 읽고, 그 core 가 ../../../rules/*.json 을 읽는다.
# WORKDIR 이 /app 이라 ../client = /client, /client/src/core 의 ../../../rules = /rules
COPY client/src/core /client/src/core
COPY rules/ /rules/

COPY ./client-react .

# 정답사진을 만드는 서버 주소. **비워 두면 "서버가 아직 안 붙었어요" 로 다룬다**
# (client-react/src/api.ts 의 `hasAnswerServer`) — 빈 값은 혼자 띄운 개발 화면을 가리키기 때문이다.
# 배포에서는 같은 주소의 nginx 가 /transfer 를 백엔드로 넘기므로 "/" 를 준다 → `/transfer` 로 나간다
ENV VITE_API_BASE=/

RUN npm run build

FROM nginx:alpine AS production

COPY --from=builder /app/dist /usr/share/nginx/html

# /api/ 를 백엔드(back:8000)로 넘긴다. 이게 없으면 바깥에서 백엔드에 닿을 길이 없다
# (Cloudflare 가 80 포트만 내보내고, 기본 nginx 는 정적 파일만 준다)
COPY ./client-react/nginx.conf /etc/nginx/conf.d/default.conf

# COPY ./dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
